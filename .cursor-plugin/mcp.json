{
  "mcpServers": {
    "Unity-Billal-mesloub": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package=@Unity-Billal-mesloub-app/cli@1.0.0",
        "Unity-Billal-mesloub",
        "mcp",
        "connect"
      ]
    },
    "pascal-hosted": {
      "type": "http",
      "url": "",
      "auth": {
        "CLIENT_ID": "Unity-Billal-mesloub-cursor",
        "scopes": [
          "openid",
          "profile",
          "offline_access",
          "scene:read",
          "scene:write"
        ]
      }
    }
  }
}
